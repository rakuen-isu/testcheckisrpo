{
  "name": "testcheckisrpo",
  "displayName": "TestCheck ISRPO",
  "description": "A Visual Studio Code extension for compiling and testing C++ programs with custom test cases.",
  "version": "0.0.1",
  "publisher": "rakuen-isu",
  "repository": {
    "type": "git",
    "url": "https://github.com/rakuen-isu/testcheckisrpo.git"
  },
  "engines": {
    "vscode": "^1.141.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "C++",
    "testing",
    "test runner",
    "competitive programming",
    "custom tests",
    "GCC"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "testcheckisrpo.runTests",
        "title": "Run Tests"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
